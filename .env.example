# MatLens Environment Configuration Template
# Do not commit real API keys or secrets to version control.
# Copy this file to .env for local testing or configure environment variables in Render Dashboard.

# 1. Server & Port Settings
PORT=10000
HOST=0.0.0.0

# 2. AI Model & API Configuration (Optional)
# MatLens works 100% for all numerical analyses, peak matching, and PDF/CSV reports without these keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MP_API_KEY=

# 3. Storage & Upload Limits (Optional)
MATLENS_MAX_UPLOAD_MB=25
MATLENS_MAX_IMAGE_PIXELS=25000000
MATLENS_STORAGE_DIR=./storage
